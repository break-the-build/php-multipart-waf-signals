# Provisional alert-only rules for PHP session upload-progress request shapes.
# Validate with suricata -T and representative pcaps before deployment.
# No CVE attribution or use-after-free reproduction is implied.

# R1: two parsed-looking field names in one inspected multipart body.
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"PHP upload progress field with body session id"; \
    flow:established,to_server; \
    http.method; content:"POST"; \
    http.content_type; content:"multipart/form-data"; nocase; startswith; \
    http.request_body; content:"name="; \
    pcre:"/name=\"PHP_SESSION_UPLOAD_PROGRESS\"/i"; \
    pcre:"/name=\"PHPSESSID\"/i"; \
    classtype:web-application-attack; sid:20260001; rev:2;)

# R3: size-only heuristic. A large Content-Length does not establish an OOM,
# repeated parts, or a vulnerability. Chunked requests lack this header.
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"PHP upload progress field with large multipart body"; \
    flow:established,to_server; \
    http.method; content:"POST"; \
    http.content_type; content:"multipart/form-data"; nocase; startswith; \
    http.content_len; byte_test:0,>=,5242880,0,string,dec; \
    http.request_body; content:"name=\"PHP_SESSION_UPLOAD_PROGRESS\""; nocase; \
    classtype:web-application-attack; sid:20260004; rev:2;)

# R2 (>=40 repeated fields) is omitted. detection_filter counts rule matches
# over time, not occurrences of a field within one request.
